{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",                       /* Modern JS target */
    "module": "CommonJS",                     /* Node.js compatibility */
    "resolveJsonModule": true,                /* Allow importing .json */
    "esModuleInterop": true,                  /* Better CommonJS interop */
    "forceConsistentCasingInFileNames": true, /* Avoid case mismatches */
    "strict": true,                           /* Enable strict type checking */
    "skipLibCheck": true,                     /* Speed up build, avoid type clashes */

    /* Modules and Paths */
    "outDir": "./dist",                       /* Emit compiled files here */
    "rootDir": ".",                       /* Source files root */
    "moduleResolution": "node",               /* Node-style resolution */
    "typeRoots": ["./types", "./node_modules/@types"],

    /* Interop */
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "types/**/*",          /* ✅ ensure express augmentation is picked up */
    "prisma/**/*",
    "src/data/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}